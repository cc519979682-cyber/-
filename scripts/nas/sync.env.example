# Copy to ~/router-sync/sync.env (NOT committed; chmod 600) and fill in.
# Router (ImmortalWrt + OpenBox, dropbear SSH, login as root)
ROUTER_HOST=192.168.x.x
ROUTER_PORT=22
ROUTER_USER=root
ROUTER_SSH_KEY=$HOME/.ssh/router_sync_ed25519
ROUTER_CONFIG=/opt/open-box/etc/config.json
# Leave empty to auto-detect sing-box on the router
ROUTER_SINGBOX=

# GitHub (fine-grained token, only this repo, Contents: Read and write)
GITHUB_REPO=cc519979682-cyber/-
GITHUB_BRANCH=main
GITHUB_TOKEN_FILE=$HOME/.config/router-sync/github_pat

# Optional
# OUTBOUND_MAP_OVERRIDE=$HOME/router-sync/outbound_map.local.json
# STRICT=1                 # fail on unknown outbound tags instead of skipping
# DRY_RUN=1                # show the diff, do not push
# ALLOW_LARGE_DELETION=1   # one-off: bypass the >10% deletion guard (do not leave on)
# CODE_URL=https://codeload.github.com/cc519979682-cyber/-/tar.gz/refs/heads/main
# CODE_DIR=/path/to/fixed/copy   # use a local copy instead of downloading each run
