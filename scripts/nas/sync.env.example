# Copy to ~/router-sync/sync.env (NOT committed; chmod 600) and fill in.

# Router (ImmortalWrt + OpenBox, dropbear SSH, login as root).
# Recommended: an ssh alias from ~/.ssh/config, e.g.
#   Host openbox-router
#     HostName 192.168.1.1
#     User root
#     IdentityFile ~/.ssh/router_sync_ed25519
#     IdentitiesOnly yes
# Then keep ROUTER_USER / ROUTER_PORT / ROUTER_SSH_KEY empty: ssh uses the alias settings.
ROUTER_HOST=openbox-router
ROUTER_USER=
ROUTER_PORT=
ROUTER_SSH_KEY=
ROUTER_CONFIG=/opt/open-box/etc/config.json
# Empty = auto-detect (first candidate: /opt/open-box/bin/sing-box)
ROUTER_SINGBOX=

# GitHub (fine-grained token, only this repo, Contents: Read and write).
# Not needed for DRY_RUN=1 (the public file is read anonymously).
GITHUB_REPO=cc519979682-cyber/-
GITHUB_BRANCH=main
GITHUB_TOKEN_FILE=$HOME/.config/router-sync/github_pat

# Optional
# OUTBOUND_MAP_OVERRIDE=$HOME/router-sync/outbound_map.local.json
# STRICT=1                 # fail on unknown outbound tags instead of skipping
# DRY_RUN=1                # show the diff, do not push
# ALLOW_LARGE_DELETION=1   # one-off: bypass the >10% deletion guard (do not leave on)
# HAND_RULES_WIN=1              # old mode: repo hand-kept rules win; default: the router is the source of truth
# INCLUDE_RULE_SETS=1           # also expand the router's rule_set lists (third-party, thousands of lines); default: only your inline route rules
# INCLUDE_RULESET_IP_DIRECT=1   # with INCLUDE_RULE_SETS=1: also publish rule-set IP DIRECT ranges (~10k lines; GEOIP,CN already covers them)
# CODE_URL=https://codeload.github.com/cc519979682-cyber/-/tar.gz/refs/heads/main
# CODE_DIR=/path/to/fixed/copy   # use a local copy instead of downloading each run
